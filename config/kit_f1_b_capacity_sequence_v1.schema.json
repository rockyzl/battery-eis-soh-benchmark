{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KIT F1 capacity-sequence B-only v1 configuration and artifact contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_id", "artifact_schema_version", "artifact_schema_sha256", "source", "readiness",
    "target", "feature_view", "validation", "models", "metrics", "resources", "authorization"
  ],
  "properties": {
    "config_id": {"const": "kit_f1_b_capacity_sequence_v1"},
    "artifact_schema_version": {"const": "kit_f1_b_capacity_sequence_v1"},
    "artifact_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["eoc_sha256", "expected_cells", "expected_capacity_endpoints"],
      "properties": {
        "eoc_sha256": {"const": "95de03af7d73efdeed97fcd13fbdca2eeabe85b2971b08394b665c8639b3e140"},
        "expected_cells": {"const": 228},
        "expected_capacity_endpoints": {"const": 3999}
      }
    },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["target_data_go", "execution_authorized", "completion_sequence_verified"],
      "properties": {
        "target_data_go": {"type": "boolean"},
        "execution_authorized": {"const": false},
        "completion_sequence_verified": {"type": "boolean"}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "kind", "name", "horizon_completed_checkups", "negative_values"],
      "properties": {
        "task_id": {"const": "F1_SOH_LOSS_PP_H3"},
        "kind": {"const": "continuous_regression_primary"},
        "name": {"const": "soh_loss_pp_h3"},
        "horizon_completed_checkups": {"const": 3},
        "negative_values": {"const": "preserve_without_clipping"}
      }
    },
    "feature_view": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "feature_names", "eis_allowed", "o2_allowed"],
      "properties": {
        "id": {"const": "B"},
        "feature_names": {
          "const": [
            "current_soh_percent", "previous_soh_percent", "two_checkups_back_soh_percent",
            "last_checkup_loss_pp", "two_interval_loss_pp", "checkup_index",
            "elapsed_days_since_q0", "normalized_cumulative_throughput_q0",
            "age_temperature_c", "age_charge_rate_c", "age_discharge_rate_c", "age_profile"
          ]
        },
        "eis_allowed": {"const": false},
        "o2_allowed": {"const": false}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["outer_group_folds", "inner_group_folds", "group"],
      "properties": {
        "outer_group_folds": {"const": 3},
        "inner_group_folds": {"const": 2},
        "group": {"const": "complete_experimental_condition"}
      }
    },
    "models": {
      "type": "object", "additionalProperties": false,
      "required": ["baselines", "elastic_net_regression", "hist_gradient_boosting_regressor"],
      "properties": {
        "baselines": {"const": ["persistence_zero_loss", "recent_slope_h3"]},
        "elastic_net_regression": {
          "const": {"alpha": 0.01, "l1_ratio": 0.1, "max_iter": 5000, "random_state": 20260801}
        },
        "hist_gradient_boosting_regressor": {
          "const": {"learning_rate": 0.05, "max_leaf_nodes": 7, "max_iter": 100, "min_samples_leaf": 20, "l2_regularization": 1.0, "random_state": 20260801}
        }
      }
    },
    "metrics": {
      "const": [
        "condition_balanced_mae_pp_v1", "condition_balanced_median_ae_pp_v1",
        "condition_balanced_rmse_pp_v1", "condition_balanced_signed_bias_pp_v1",
        "condition_balanced_r2_v1"
      ]
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["soft_drain_seconds", "hard_stop_seconds", "hard_rss_bytes", "minimum_free_bytes", "threadpool_limit"],
      "properties": {
        "soft_drain_seconds": {"const": 420},
        "hard_stop_seconds": {"const": 480},
        "hard_rss_bytes": {"const": 2147483648},
        "minimum_free_bytes": {"const": 268435456},
        "threadpool_limit": {"const": 1}
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["scientific_result", "publication_ready", "resume_approved", "formal_model_result", "protected_test_result", "selection_performed"],
      "properties": {
        "scientific_result": {"const": false},
        "publication_ready": {"const": false},
        "resume_approved": {"const": false},
        "formal_model_result": {"const": false},
        "protected_test_result": {"const": false},
        "selection_performed": {"const": false}
      }
    }
  },
  "$defs": {
    "falseFlags": {
      "type": "object",
      "properties": {
        "scientific_result": {"const": false}, "publication_ready": {"const": false},
        "resume_approved": {"const": false}, "formal_model_result": {"const": false},
        "protected_test_result": {"const": false}, "selection_performed": {"const": false}
      },
      "required": ["scientific_result", "publication_ready", "resume_approved", "formal_model_result", "protected_test_result", "selection_performed"]
    },
    "sourceManifest": {
      "allOf": [
        {"$ref": "#/$defs/falseFlags"},
        {"type": "object", "additionalProperties": false,
         "required": ["scientific_result", "publication_ready", "resume_approved", "formal_model_result", "protected_test_result", "selection_performed", "artifact_schema_version", "run_kind", "source_archive", "source_counts"],
         "properties": {
           "scientific_result": {}, "publication_ready": {}, "resume_approved": {}, "formal_model_result": {}, "protected_test_result": {}, "selection_performed": {},
           "artifact_schema_version": {"const": "kit_f1_b_capacity_sequence_v1"},
           "run_kind": {"const": "KIT_F1_B_CAPACITY_SEQUENCE_V1"},
           "source_archive": {"type": "object", "additionalProperties": false, "required": ["path_name", "sha256"], "properties": {"path_name": {"type": "string", "minLength": 1}, "sha256": {"const": "95de03af7d73efdeed97fcd13fbdca2eeabe85b2971b08394b665c8639b3e140"}}},
           "source_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
         }}
      ]
    },
    "snapshotRow": {
      "allOf": [
        {"$ref": "#/$defs/falseFlags"},
        {"type": "object", "additionalProperties": false,
         "required": ["scientific_result", "publication_ready", "resume_approved", "formal_model_result", "protected_test_result", "selection_performed", "artifact_schema_version", "snapshot_id", "cell_id", "condition_id", "mode", "checkup_index", "timestamp_s", "q0_ah", "capacity_ah", "soh_percent", "future_soh_percent", "soh_loss_pp_h3", "h3_endpoint_snapshot_id", "h3_checkup_index", "f1_target_available", "eligibility_status", "b_values"],
         "properties": {
           "scientific_result": {}, "publication_ready": {}, "resume_approved": {}, "formal_model_result": {}, "protected_test_result": {}, "selection_performed": {},
           "artifact_schema_version": {"const": "kit_f1_b_capacity_sequence_v1"},
           "snapshot_id": {"type": "string", "minLength": 1}, "cell_id": {"type": "string", "minLength": 1},
           "condition_id": {"type": "integer", "minimum": 1}, "mode": {"enum": ["calendar", "cyclic", "profile"]},
           "checkup_index": {"type": "integer", "minimum": 0}, "timestamp_s": {"type": "number", "minimum": 0},
           "q0_ah": {"type": "number", "exclusiveMinimum": 0}, "capacity_ah": {"type": "number", "exclusiveMinimum": 0},
           "soh_percent": {"type": "number"}, "future_soh_percent": {"type": ["number", "null"]},
           "soh_loss_pp_h3": {"type": ["number", "null"]}, "h3_endpoint_snapshot_id": {"type": ["string", "null"]},
           "h3_checkup_index": {"type": ["integer", "null"], "minimum": 0}, "f1_target_available": {"type": "boolean"},
           "eligibility_status": {"enum": ["eligible_f1_b", "insufficient_history", "no_h3_followup"]},
           "b_values": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": ["number", "null"]}}
         }}
      ]
    },
    "foldRegistry": {"type": "object", "additionalProperties": false, "required": ["artifact_schema_version", "run_kind", "split_policy", "view", "fold_sha256", "modes"], "properties": {"artifact_schema_version": {"const": "kit_f1_b_capacity_sequence_v1"}, "run_kind": {"const": "KIT_F1_B_CAPACITY_SEQUENCE_V1"}, "split_policy": {"const": "condition_grouped_outer3_inner2_b_only_v1"}, "view": {"const": "B"}, "fold_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "modes": {"type": "object", "additionalProperties": {"type": "array"}}}},
    "predictionRow": {
      "allOf": [
        {"$ref": "#/$defs/falseFlags"},
        {"type": "object", "additionalProperties": false,
         "required": ["scientific_result", "publication_ready", "resume_approved", "formal_model_result", "protected_test_result", "selection_performed", "artifact_schema_version", "task_id", "view", "model_role", "model_family", "snapshot_id", "cell_id", "condition_id", "mode", "outer_fold", "observed_soh_loss_pp_h3", "predicted_soh_loss_pp_h3", "current_soh_percent", "observed_future_soh_percent", "predicted_future_soh_percent"],
         "properties": {
           "scientific_result": {}, "publication_ready": {}, "resume_approved": {}, "formal_model_result": {}, "protected_test_result": {}, "selection_performed": {},
           "artifact_schema_version": {"const": "kit_f1_b_capacity_sequence_v1"}, "task_id": {"const": "F1_SOH_LOSS_PP_H3"},
           "view": {"const": "B"}, "model_role": {"enum": ["baseline", "fitted_candidate"]},
           "model_family": {"enum": ["persistence_zero_loss", "recent_slope_h3", "elastic_net_regression", "hist_gradient_boosting_regressor"]},
           "snapshot_id": {"type": "string"}, "cell_id": {"type": "string"}, "condition_id": {"type": "integer", "minimum": 1},
           "mode": {"enum": ["calendar", "cyclic", "profile"]}, "outer_fold": {"type": "integer", "minimum": 0, "maximum": 2},
           "observed_soh_loss_pp_h3": {"type": "number"}, "predicted_soh_loss_pp_h3": {"type": "number"},
           "current_soh_percent": {"type": "number"}, "observed_future_soh_percent": {"type": "number"}, "predicted_future_soh_percent": {"type": "number"}
         }}
      ]
    },
    "engineSummary": {
      "allOf": [
        {"$ref": "#/$defs/falseFlags"},
        {"type": "object", "additionalProperties": false,
         "required": ["scientific_result", "publication_ready", "resume_approved", "formal_model_result", "protected_test_result", "selection_performed", "artifact_schema_version", "run_kind", "view", "planned_fits", "completed_fits", "prediction_rows", "metrics", "config_sha256", "artifact_schema_sha256", "artifact_paths"],
         "properties": {
           "scientific_result": {}, "publication_ready": {}, "resume_approved": {}, "formal_model_result": {}, "protected_test_result": {}, "selection_performed": {},
           "artifact_schema_version": {"const": "kit_f1_b_capacity_sequence_v1"}, "run_kind": {"const": "KIT_F1_B_CAPACITY_SEQUENCE_V1"}, "view": {"const": "B"},
           "planned_fits": {"type": "integer", "minimum": 1}, "completed_fits": {"type": "integer", "minimum": 1}, "prediction_rows": {"type": "integer", "minimum": 1},
           "metrics": {"type": "array"},
           "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "artifact_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
           "artifact_paths": {"const": ["source_manifest.json", "snapshot_manifest.jsonl", "fold_registry.json", "oof_predictions.jsonl", "engine_summary.json"]}
         }}
      ]
    }
  }
}
